# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# env / secrets — never in history
.env
.env.*
!.env.example
*.local

# logs
*.log

# OS junk
.DS_Store
Thumbs.db

# AI assistant workspaces — local skill packs, agent memory and session data
# (22MB+ of vendored third-party skills). They belong to this machine, not to
# the project, so the whole tree stays out of history.
.codebuddy/
.claude/

# test / tooling artifacts
coverage/
test-results/
playwright-report/
